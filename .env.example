# ==============================================================================
# Coffee Chain Inventory & Order System: Environment Variables
# ==============================================================================

# Project Settings
PROJECT_NAME="Coffee Chain Inventory API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_postgres_password"
POSTGRES_DB="coffee_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:secure_postgres_password@postgres:5432/coffee_db"

# Telegram Bot Configuration
BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"
WAREHOUSE_CHAT_ID="-1001234567890"
TELEGRAM_WAREHOUSE_CHAT_ID="-1001234567890"

# Telegram Mini App (Web App URL)
# For local dev: http://localhost (or ngrok/localtunnel HTTPS URL for Telegram client)
# For production: https://coffee.yourdomain.com
MINI_APP_URL="http://localhost"
WEBAPP_URL="http://localhost"

# Administrator / Warehouse Telegram User IDs (comma-separated for multiple admins)
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Vision LLM OCR Configuration for Supply Invoices
# Provider: 'gemini' (default, Google Gemini 2.5 Flash) or 'openai' (gpt-4o-mini)
OCR_PROVIDER="gemini"
OCR_MODEL="gemini-2.5-flash"
AI_API_KEY="YOUR_GEMINI_OR_OPENAI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
