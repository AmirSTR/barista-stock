# Application
PROJECT_NAME="Coffee Chain Inventory API"
API_V1_STR=/api/v1
DEBUG=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL (Docker Compose defaults)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coffee_db
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/coffee_db

# Initial database setup
AUTO_SEED=true
INITIAL_STOCK_QTY=50

# Telegram bot. Leave BOT_TOKEN empty to run API-only locally.
BOT_ENABLED=true
BOT_TOKEN=
WAREHOUSE_CHAT_ID=
MINI_APP_URL=http://localhost:8080
ADMIN_TELEGRAM_IDS=
TELEGRAM_AUTH_REQUIRED=false
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
API_ADMIN_TOKEN=

# Invoice OCR. Demo mode is opt-in and must stay false in production.
OCR_PROVIDER=gemini
OCR_MODEL=gemini-2.5-flash
OCR_DEMO_MODE=false
GEMINI_API_KEY=
# For OCR_PROVIDER=openai use both values below instead:
# OCR_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Standalone frontend build
VITE_API_URL=http://localhost:8000
VITE_ENABLE_MOCKS=false
